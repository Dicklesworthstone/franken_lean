# Build artifacts
/target
/target_local
target-*/
target_*/
crates/*/target/
a.out

# FrankenLean on-disk state — never commit. Ledger CAS stores, frankensqlite
# databases, olean/olean-next artifact trees, and Tribunal evidence stores are
# content-addressed build products; none of it belongs in git.
/.fln/
*.flnpack
/ledger-store/
*.olean
# Pinned Tribunal C3 compatibility fixtures are source evidence, not build outputs.
!/tribunal/fixtures/c3/*.olean
# Pinned real-mathlib G0-1 fixtures are source evidence likewise (manifest-bound).
!/tribunal/fixtures/mathlib/*.olean
*.ilean
*.olean-next

