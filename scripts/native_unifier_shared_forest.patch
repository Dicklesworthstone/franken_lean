+
+/// Captured metavariable contexts share the same large type DAG. Reserving
+/// generated binder names must walk the forest once, not once per capture.
+fn shared_context_transaction() -> ElabTxn {
+    let mut txn = transaction();
+    let mut shared = nat();
+    for _ in 0..160 {
+        shared = pi(nat(), shared);
+    }
+    local(&mut txn, "sharedFunction", shared);
+    for index in 0..64 {
+        natural(&mut txn, &format!("captured{index}"), nat());
+    }
+    txn
+}
+
+#[test]
+fn reserving_shared_captured_contexts_is_bounded_by_the_dag_not_the_unrolled_forest() {
+    let mut txn = shared_context_transaction();
+    let before = txn.clone();
+    txn.budget.max_heartbeats = 3_000;
+    let report = txn.unify(&numeral(1), &numeral(1), budget()).unwrap();
+    assert!(report.unifier_steps < 3_000, "{report:?}");
+    assert!(report.visited_nodes < 1_000, "{report:?}");
+    assert_eq!(report.kernel_checks, 0);
+    assert_semantics_unchanged(&txn, &before);
+}
+
+#[test]
+fn shared_context_reservation_still_obeys_resource_and_cancellation_stops() {
+    let initial = shared_context_transaction();
+    let mut starved = initial.clone();
+    starved.budget.max_heartbeats = 20;
+    assert_eq!(
+        starved
+            .unify(&numeral(1), &numeral(1), budget())
+            .unwrap_err(),
+        UnificationError::HeartbeatLimit
+    );
+    assert_semantics_unchanged(&starved, &initial);
+    assert!(starved.budget.heartbeats_consumed > 0);
+
+    let mut cancelled = initial.clone();
+    let calls = Cell::new(0);
+    assert_eq!(
+        cancelled
+            .unify_many_with(&[(numeral(1), numeral(1))], budget(), &|| {
+                calls.set(calls.get() + 1);
+                calls.get() > 30
+            })
+            .unwrap_err(),
+        UnificationError::Cancelled
+    );
+    assert_semantics_unchanged(&cancelled, &initial);
+    assert!(cancelled.budget.heartbeats_consumed > 0);
+}
