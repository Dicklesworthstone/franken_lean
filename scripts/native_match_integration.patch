+        "def f (b : Bool) : Nat := match b with | true => let x : Nat := 7; x + 1 | false => 0\ntheorem yes : f true = 8 := by rfl",
+    );
+    check(
+        "def f (b : Bool) : Nat := let x := match b with | true => let y := 4; y + 1 | false => 0; x + 2\ntheorem yes : f true = 7 := by rfl",
