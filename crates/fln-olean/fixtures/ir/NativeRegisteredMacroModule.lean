module
prelude
public import Init
public section

-- All dispatch names are generated by these declarations and discovered from
-- the saved macro attribute journal by the Rust fixture consumer.
macro (name := registeredChoice) "registeredChoice%" a:term "," _b:term : term =>
  pure a

macro_rules (kind := registeredChoice)
  | `(registeredChoice% $a, $b) => do
    if a.raw.getNumArgs == 1 then
      throw Lean.Macro.Exception.unsupportedSyntax
    else
      pure b

macro_rules (kind := registeredChoice)
  | stx => Lean.Macro.withFreshMacroScope do
    if stx.getNumArgs == 0 then
      throw (Lean.Macro.Exception.error stx "registered λ\x00error")
    else
      throw Lean.Macro.Exception.unsupportedSyntax

#eval registeredChoice% 10, 20
#eval registeredChoice% (10 + 1), 20
