+//! Native quoted macros receive syntax, not pre-expanded arguments.
+//! The pinned TermElabM.elabTermAux expands the outer node before elaborating
+//! its replacement. These cells exercise that order through both checkers.
+#![forbid(unsafe_code)]
+use fln::{Budget, Engine, EngineAdmissionLimits, KVMap, SourceCheckLimits};
+
+fn check(source: &str) -> Result<fln::Outcome<fln::SourceFileCheck>, fln::SourceCheckError> {
+    let admission = EngineAdmissionLimits::new(Budget::for_stack_bytes(2 << 20));
+    Engine::with_source_seed(admission)
+        .unwrap()
+        .into_complete()
+        .unwrap()
+        .check_source_files(
+            &[source.as_bytes()],
+            &KVMap::new(),
+            SourceCheckLimits::new(admission),
+        )
+}
+
+const RECURSIVE: &str = "syntax \"forever\" : term\nmacro_rules | `(forever) => `(forever)\n";
+
+#[test]
+fn a_macro_can_discard_a_recursive_syntax_argument() {
+    let source = format!(
+        "{RECURSIVE}macro \"discard \" x:term:max : term => `(42)\n\
+        theorem ignored : discard forever = 42 := rfl\n"
+    );
+    let checked = check(&source)
+        .unwrap_or_else(|e| panic!("{source}\n{e:?}"))
+        .into_complete()
+        .expect("the council completes");
+    assert_eq!(checked.theorems, 1);
+}
+
+#[test]
+fn forwarding_a_recursive_argument_still_refuses_and_never_admits_a_proof() {
+    let source = format!(
+        "{RECURSIVE}macro \"forward \" x:term:max : term => `($x)\n\
+        theorem required : forward forever = 42 := rfl\n"
+    );
+    assert!(check(&source).is_err());
+}
+
+#[test]
+fn a_macro_can_discard_one_argument_and_expand_the_other() {
+    let source = format!(
+        "{RECURSIVE}macro \"choose(\" x:term \", \" y:term \")\" : term => `($y)\n\
+        macro \"answer\" : term => `(42)\n\
+        theorem selected : choose(forever, answer) = 42 := rfl\n"
+    );
+    assert_eq!(
+        check(&source)
+            .unwrap_or_else(|e| panic!("{source}\n{e:?}"))
+            .into_complete()
+            .unwrap()
+            .theorems,
+        1
+    );
+}
+
+#[test]
+fn a_tactic_macro_can_discard_an_unused_recursive_tactic() {
+    let source = "syntax \"forever_tac\" : tactic\n\
+        macro_rules | `(tactic| forever_tac) => `(tactic| forever_tac)\n\
+        macro \"discard_tac \" t:tactic : tactic => `(tactic| rfl)\n\
+        theorem ignored : (42 : Nat) = 42 := by discard_tac forever_tac\n";
+    assert_eq!(
+        check(source)
+            .unwrap_or_else(|e| panic!("{source}\n{e:?}"))
+            .into_complete()
+            .unwrap()
+            .theorems,
+        1
+    );
+}
+
+#[test]
+fn discarded_macro_arguments_are_not_executed_by_the_vm_path() {
+    let admission = EngineAdmissionLimits::new(Budget::for_stack_bytes(2 << 20));
+    let engine = Engine::with_source_seed(admission)
+        .unwrap()
+        .into_complete()
+        .unwrap();
+    let source = format!(
+        "{RECURSIVE}macro \"discard \" x:term:max : term => `(42)\n#eval discard forever\n"
+    );
+    let completed = engine
+        .execute_source_commands_with_checks(
+            source.as_bytes(),
+            &KVMap::new(),
+            fln::EngineExecutionLimits::new(admission.kernel),
+        )
+        .unwrap_or_else(|e| panic!("{source}\n{e:?}"))
+        .into_complete()
+        .unwrap();
+    let fln::VmExit::Returned(returned) = &completed.batch.executions.last().unwrap().exit else {
+        panic!("the native VM returns the expansion's value");
+    };
+    assert_eq!(
+        fln_vm::interpreter::nat_decimal(&returned.value).as_deref(),
+        Some("42")
+    );
+}
