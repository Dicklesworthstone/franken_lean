--- /dev/null
+++ b/crates/fln-parse/src/extensions/expansion_order_tests.rs
@@ -0,0 +1,150 @@
+//! Direct expansion regressions: raw-argument order, hygiene and termination.
+use super::*;
+
+fn n(text: &str) -> Name {
+    Name::from_components([text])
+}
+fn atom(text: &str) -> Syntax {
+    Syntax::atom(SourceInfo::None, text)
+}
+fn ident(name: Name) -> Syntax {
+    Syntax::Ident {
+        info: SourceInfo::None,
+        raw_val: ByteSpan::empty_at(BytePos(0)),
+        val: name,
+        preresolved: Vec::new(),
+    }
+}
+fn rule(variables: Vec<(usize, Name)>, rhs: Syntax) -> Arc<NotationRule> {
+    Arc::new(NotationRule {
+        variables,
+        rhs,
+        prechecked: false,
+    })
+}
+fn expander(rules: Vec<(&str, Arc<NotationRule>)>) -> Expander {
+    Expander {
+        rules: Arc::new(
+            rules
+                .into_iter()
+                .map(|(kind, rule)| (n(kind), rule))
+                .collect(),
+        ),
+        interpolation_kinds: Arc::default(),
+        expansions: Rc::new(Cell::new(0)),
+        context: n("OrderTest"),
+    }
+}
+
+#[test]
+fn discarded_arguments_take_no_macro_scope_and_do_not_recurse() {
+    let recursive = Syntax::node(n("loop"), Vec::new());
+    let expander = expander(vec![
+        ("ignore", rule(Vec::new(), atom("42"))),
+        ("loop", rule(Vec::new(), recursive.clone())),
+    ]);
+    assert_eq!(
+        expander
+            .expand(&Syntax::node(n("ignore"), vec![recursive]))
+            .unwrap(),
+        atom("42")
+    );
+    assert_eq!(expander.expansions.get(), 1, "only the outer macro ran");
+}
+
+#[test]
+fn each_copy_of_an_argument_expands_under_its_own_fresh_scope() {
+    let x = macro_variable(&n("x"));
+    let expander = expander(vec![
+        (
+            "duplicate",
+            rule(
+                vec![(0, x.clone())],
+                Syntax::node(n("pair"), vec![ident(x.clone()), ident(x)]),
+            ),
+        ),
+        ("fresh", rule(Vec::new(), ident(n("introduced")))),
+    ]);
+    let output = expander
+        .expand(&Syntax::node(
+            n("duplicate"),
+            vec![Syntax::node(n("fresh"), Vec::new())],
+        ))
+        .unwrap();
+    let Syntax::Node { args, .. } = &output else {
+        panic!("pair expected")
+    };
+    let [
+        Syntax::Ident { val: left, .. },
+        Syntax::Ident { val: right, .. },
+    ] = args.as_slice()
+    else {
+        panic!("each macro introduces one identifier")
+    };
+    assert_ne!(
+        left, right,
+        "duplicated input must not share an already expanded macro"
+    );
+    assert_eq!(left.erase_macro_scopes(), n("introduced"));
+    assert_eq!(right.erase_macro_scopes(), n("introduced"));
+    assert_eq!(
+        expander.expansions.get(),
+        3,
+        "outer macro then two inner expansions"
+    );
+}
+
+#[test]
+fn a_forwarded_recursive_argument_still_reaches_the_depth_refusal() {
+    let x = macro_variable(&n("x"));
+    let recursive = Syntax::node(n("loop"), Vec::new());
+    let expander = expander(vec![
+        ("forward", rule(vec![(0, x.clone())], ident(x))),
+        ("loop", rule(Vec::new(), recursive.clone())),
+    ]);
+    assert_eq!(
+        expander.expand(&Syntax::node(n("forward"), vec![recursive])),
+        Err("notation expands past the expansion depth")
+    );
+}
+
+#[test]
+fn exhausting_fresh_macro_scopes_is_a_refusal_not_an_overflow() {
+    let expander = expander(vec![("constant", rule(Vec::new(), atom("42")))]);
+    expander.expansions.set(u64::MAX);
+    for _ in 0..2 {
+        assert_eq!(
+            expander.expand(&Syntax::node(n("constant"), Vec::new())),
+            Err("macro scope limit")
+        );
+        assert_eq!(expander.expansions.get(), u64::MAX);
+    }
+}
+
+#[test]
+fn ordinary_syntax_depth_uses_the_heap_not_macro_recursion_depth() {
+    std::thread::Builder::new()
+        .stack_size(256 * 1024)
+        .spawn(|| {
+            let expander = expander(vec![("constant", rule(Vec::new(), atom("42")))]);
+            let mut input = Syntax::node(n("constant"), Vec::new());
+            for _ in 0..4000 {
+                input = Syntax::node(n("wrapper"), vec![input]);
+            }
+            let output = expander.expand(&input).unwrap();
+            let mut cursor = &output;
+            for _ in 0..4000 {
+                let Syntax::Node { kind, args, .. } = cursor else {
+                    panic!("wrapper expected")
+                };
+                assert_eq!(kind, &n("wrapper"));
+                assert_eq!(args.len(), 1);
+                cursor = &args[0];
+            }
+            assert_eq!(cursor, &atom("42"));
+            assert_eq!(expander.expansions.get(), 1);
+        })
+        .unwrap()
+        .join()
+        .unwrap();
+}
